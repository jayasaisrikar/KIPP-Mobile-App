{
  "name": "kipp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kipp stack backend — Postgres (conventional tables) + Neo4j (person graph) for the KIPP mobile app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "graph:bootstrap": "tsx --env-file=.env src/graph/bootstrap.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "jose": "^6.0.11",
    "neo4j-driver": "^5.28.1",
    "pg": "^8.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
