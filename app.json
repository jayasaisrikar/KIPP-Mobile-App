{
  "expo": {
    "name": "KIPP",
    "slug": "kipp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "kipp",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kipp.companion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101317",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.kipp.companion",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8FA9BC"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "KIPP uses the microphone only when you press and hold to talk."
        }
      ],
      "expo-splash-screen",
      "expo-font",
      "expo-web-browser",
      "expo-status-bar"
    ]
  }
}
